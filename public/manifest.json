{
    "manifest_version": 3,
    "name": "AI Page Summarizer",
    "version": "1.0",
    "permissions": ["activeTab", "scripting", "tabs"],
    "host_permissions": ["<all_urls>"],
  
    "background": {
      "service_worker": "background.js",
      "type": "module"
    },
  
    "action": {
      "default_popup": "index.html"
    },
  
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"]
      }
    ]
  }